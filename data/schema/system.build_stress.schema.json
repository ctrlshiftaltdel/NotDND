{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "system 族（system.build_stress）",
  "description": "构建引擎第五节：应力上限公式（体魄 + 心智 + 5）、获取表（5 条）、惩罚分段（4 段：0–49% / 50–79% / 80–99% / 100% 崩溃）、崩溃事件四步、降低手段（4 条）。源自 docs/system/02b-forge-engine.md。只使用 data/FORMAT.md 第 7 节的关键字子集。",
  "type": "object",
  "required": ["schema_version", "kind", "source", "declared", "cap", "gain", "penalty_bands", "overload_event", "reduction"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "system.build_stress"},
    "source": {"$ref": "common.schema.json#/$defs/source"},
    "declared": {
      "type": "object",
      "required": ["gain_sources", "penalty_bands", "reduction_methods", "overload_steps"],
      "properties": {
        "gain_sources": {"const": 5},
        "penalty_bands": {"const": 4},
        "reduction_methods": {"const": 4},
        "overload_steps": {"const": 4}
      },
      "additionalProperties": false
    },
    "cap": {
      "type": "object",
      "required": ["formula", "typical_range", "source"],
      "properties": {
        "formula": {"type": "string", "minLength": 1},
        "typical_range": {"type": "string", "minLength": 1},
        "source": {"$ref": "common.schema.json#/$defs/source"}
      },
      "additionalProperties": false
    },
    "gain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["behaviour", "amount", "source"],
        "properties": {
          "behaviour": {"type": "string", "minLength": 1},
          "amount": {"type": "integer", "minimum": 1},
          "source": {"$ref": "common.schema.json#/$defs/source"}
        },
        "additionalProperties": false
      }
    },
    "penalty_bands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["band", "effect", "source"],
        "properties": {
          "band": {"type": "string", "minLength": 1},
          "effect": {"type": "string", "minLength": 1},
          "source": {"$ref": "common.schema.json#/$defs/source"}
        },
        "additionalProperties": false
      }
    },
    "overload_event": {
      "type": "object",
      "required": ["trigger", "trigger_source", "steps"],
      "properties": {
        "trigger": {"type": "string", "minLength": 1},
        "trigger_source": {"$ref": "common.schema.json#/$defs/source"},
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["order", "step", "source"],
            "properties": {
              "order": {"type": "integer", "minimum": 1},
              "step": {"type": "string", "minLength": 1},
              "source": {"$ref": "common.schema.json#/$defs/source"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "reduction": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "amount", "source"],
        "properties": {
          "method": {"type": "string", "minLength": 1},
          "amount": {"anyOf": [{"type": "integer", "maximum": -1}, {"type": "null"}]},
          "note": {"type": "string", "minLength": 1},
          "source": {"$ref": "common.schema.json#/$defs/source"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
