  "acts": [
    {
      "id": "act-1",
      "name": "第一幕 · 窗口",
      "level_range": "1",
      "summary": "目标：让玩家第一次面对「资源不够，必须有人做决定」，并完成一次真正的轨道计算。幕末应当发生：玩家选定去哑铃还是去汀洲，并为这个选择承担一个即时的、关系性的代价。",
      "scenes": [
        "1.1 砾海·锚地（船坞）：查航路卡／找沙棠喝一杯打听／直接谈去哑铃的合同（轨道学 DF 13，构建 2 成功；算错＝多花 2 格 Δv）",
        "1.2 船坞工会（岑岭）：雇佣技师／借设备／修闭环（维生 DF 12；失败＝闭环降级，恢复类效果减半）",
        "1.3 与席砚生对谈：问哑铃旧事／要旧规程密码／请他同行（共感 DF 14；失败＝他拒绝，但留下一个名字）",
        "1.4 出发前（窗口开启）：玩家做最终配平（轨道学 DF 14；失败＝货物超重，必须抛掉一件，可能是救命药）",
        "1.5 航行中（延迟通信）：玩家发第一封信，等待回复（信延 DF 13；回复永远比预期晚）"
      ],
      "tasks": [
        "Q-00"
      ],
      "source": "docs/scenario/S8-起步战役集.md:606"
    },
    {
      "id": "act-2",
      "name": "第二幕 · 出舱",
      "level_range": "1",
      "summary": "目标：让玩家在真空里作业，第一次体会「每一次破舱都在闭环上留一个洞」。幕末应当发生：玩家带回哑铃站里的第一手证据（不是样本库，是别的东西），并知道站里只剩两个人。",
      "scenes": [
        "2.1 哑铃外壳（系绳出舱）：从对接环进入／从破损舱门／先敲壳听回声（舱外 DF 14，系留势 +2 防护；系绳断裂＝队友需救援判定）",
        "2.2 站内走廊：找主控／找样本库／找发信的人（维生 DF 13；失败＝氧气只够一次深入，必须在两者之间选）",
        "2.3 样本库：取样／只看不取／封库（科学或分析 DF 15；失败＝样本被污染，但得到完整实验日志）",
        "2.4 遭遇（有人不希望他们带东西走）：谈判／潜行／动手（潜行 DF 14／说服 DF 14；动手＝走私船长介入，暴露「谁雇的走私船长」）",
        "2.5 返船：玩家必须在闭环耗尽前回到船上（舱外 DF 13；超时＝全队各受一次失温或缺氧，留下永久辐射载荷）"
      ],
      "tasks": [
        "Q-00"
      ],
      "source": "docs/scenario/S8-起步战役集.md:647"
    },
    {
      "id": "act-3",
      "name": "第三幕 · 回信",
      "level_range": "1",
      "summary": "目标：让玩家在「信息永远不完全、资源永远不够」的条件下，替一群人做一个必须有人做的决定。幕末应当发生：玩家把真相（或它的一个版本）送达某一方，并永久改变这条航线的联络方式。",
      "scenes": [
        "3.1 返回航路（延迟通信）：直接公开／私发给某方／再发一封信问清楚（信延 DF 15；回复都会迟到，必须凭发信时的信息决定）",
        "3.2 汀洲·冷滩港：找共同事务局韩砚秋／找沈知微／走何燎（熄灯会）（说服 DF 15；失败＝真相被压，但一名公务员私下备份）",
        "3.3 哑铃隔离站攻防（可选）：阻止检疫署强制接管／协助接管／撤离（安保或技术 DF 14；战斗非必需，可用一次论战让检疫署退让）",
        "3.4 收束：谁承担代价——玩家决定谁为这个决定负责（无判定；这是本册「没有无损按钮」的落地）"
      ],
      "source": "docs/scenario/S8-起步战役集.md:683"
    }
  ],
