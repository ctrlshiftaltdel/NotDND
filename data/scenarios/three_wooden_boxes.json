  "acts": [
    {
      "id": "act-1",
      "name": "第一幕 · 第一票",
      "level_range": "1",
      "summary": "目标：让玩家体验「接活—踩点—动手—撤离」的完整循环，并在撤离段第一次体会「出来比进去难」。幕末应当发生：玩家拿到第一件赃物（一份不起眼的文件），并第一次遇见雇主霍砚或追猎者岑照中的至少一个。",
      "scenes": [
        "1.1 五阶·灰市（绳会账房）：接活／砍价／追问东西是什么（人脉或欺骗 DF 13；追问失败＝带着疑问接活）",
        "1.2 四阶·铜环（判牍阁外踩点）：白天以查档身份进／夜间走外墙／找内应黎望留门（察觉 DF 12／欺骗 DF 13；失败＝预案点 −1）",
        "1.3 判牍阁内（动手）：潜行开柜／伪装调档／策反黎望（巧手 DF 14／分析 DF 13；失败＝静默值 +2，增援提前）",
        "1.4 撤离段（铜环走廊）：走外墙下行／混进吊篮／走检修井（潜行 DF 13／杂技 DF 12；失败＝静默值 +2 且一次遭遇）",
        "1.5 交货（霍砚的第一次接触）：玩家自由应对（论战立场 10；谈崩＝之后每次结算 −5%，但委托继续）"
      ],
      "tasks": [
        "Q-00"
      ],
      "source": "docs/scenario/S8-起步战役集.md:326"
    },
    {
      "id": "act-2",
      "name": "第二幕 · 上行",
      "level_range": "1",
      "summary": "目标：玩家进入二阶白壁，面对「不偷也能赢」的第一次考验，并遭遇同行竞争者罗屏。幕末应当发生：玩家确认赃物不是普通赃物，而是某种「钥匙」，并且知道雇主手里不止他们一队。",
      "scenes": [
        "2.1 二阶·白壁（听泉馆）：夜间取鸟（潜行）／冒充检修（伪装）／听完老夫人讲完（不偷）（潜行 DF 14／欺骗 DF 13）",
        "2.2 听泉馆地库：看洗印模具／找阿宓留的东西／直接撤（手艺 DF 13；失败＝改走循环泵通道，杂技 DF 15）",
        "2.3 三阶·中庭（竞争者遭遇）：抢在罗屏之前／与罗屏合作／让罗屏先得手（先攻或杂技 DF 13；让先＝拿到罗屏的图）",
        "2.4 后巷（对账）：玩家把三件赃物摆上桌（分析 DF 14；没拼出也无妨，霍砚会「不经意地」提醒）"
      ],
      "tasks": [
        "Q-00"
      ],
      "source": "docs/scenario/S8-起步战役集.md:368"
    },
    {
      "id": "act-3",
      "name": "第三幕 · 回响",
      "level_range": "1",
      "summary": "目标：玩家识破霍砚「用他们的手凑齐九钥」，并做出第一次立场选择。幕末应当发生：玩家进入冠台前哨，获得「元柜」的线索，并明确下一步是继续替霍砚干活、反水、还是自立。",
      "scenes": [
        "3.1 冠台前哨：混进礼仪队伍／从竖井摸进／用公文调档（欺骗 DF 16／技术 DF 15；失败＝守夜局围拢，岑照提出交易）",
        "3.2 与霍砚对质：直接质问／交钥匙留副本／不交（说服 DF 16／欺骗 DF 16；谈崩＝霍砚取消委托并排布后续，玩家获得反制窗口）",
        "3.3 与岑照周旋（若触发）：交一样换安全／反问她要哪样／开打（直觉 DF 15；动手＝岑照首领战，可选）",
        "3.4 收束：三只匣子——玩家在三只相似木匣中选择（无判定；选错也推进，解锁「同行竞争者反应」）"
      ],
      "source": "docs/scenario/S8-起步战役集.md:404"
    }
  ],
