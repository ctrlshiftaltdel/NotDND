{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "system 族（system.reputation）",
  "description": "互动层第六节：声望轴 7 档（−3 ~ +3）、Bond 5 级、关系维持与衰减、敌对者 Nemesis。源自 docs/system/03-interaction-layer.md。只使用 data/FORMAT.md 第 7 节的关键字子集。",
  "type": "object",
  "required": ["schema_version", "kind", "source", "note", "declared", "reputation", "reputation_note", "bonds", "bond_rulings", "bond_decay", "bond_rupture", "nemesis"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "system.reputation"},
    "source": {"$ref": "common.schema.json#/$defs/source"},
    "note": {"type": "string", "minLength": 1},
    "declared": {
      "type": "object",
      "required": ["reputation_axis", "bond_levels", "bond_rulings", "nemesis_duties"],
      "properties": {
        "reputation_axis": {"const": 7},
        "bond_levels": {"const": 5},
        "bond_rulings": {"const": 3},
        "nemesis_duties": {"const": 3}
      },
      "additionalProperties": false
    },
    "reputation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["value", "label", "expression", "source"],
        "properties": {
          "value": {"type": "integer", "minimum": -3, "maximum": 3},
          "label": {"type": "string", "minLength": 1},
          "expression": {"type": "string", "minLength": 1},
          "source": {"$ref": "common.schema.json#/$defs/source"}
        },
        "additionalProperties": false
      }
    },
    "reputation_note": {
      "type": "object",
      "required": ["rule", "source"],
      "properties": {
        "rule": {"type": "string", "minLength": 1},
        "source": {"$ref": "common.schema.json#/$defs/source"}
      },
      "additionalProperties": false
    },
    "bonds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "name", "request", "source"],
        "properties": {
          "level": {"type": "integer", "minimum": 1, "maximum": 5},
          "name": {"type": "string", "minLength": 1},
          "request": {"type": "string", "minLength": 1},
          "source": {"$ref": "common.schema.json#/$defs/source"}
        },
        "additionalProperties": false
      }
    },
    "bond_rulings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["order", "case", "ruling", "source"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "case": {"type": "string", "minLength": 1},
          "ruling": {"type": "string", "minLength": 1},
          "source": {"$ref": "common.schema.json#/$defs/source"}
        },
        "additionalProperties": false
      }
    },
    "bond_decay": {
      "type": "object",
      "required": ["rule", "source"],
      "properties": {
        "rule": {"type": "string", "minLength": 1},
        "source": {"$ref": "common.schema.json#/$defs/source"}
      },
      "additionalProperties": false
    },
    "bond_rupture": {
      "type": "object",
      "required": ["causes", "rule", "source"],
      "properties": {
        "causes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "rule": {"type": "string", "minLength": 1},
        "source": {"$ref": "common.schema.json#/$defs/source"}
      },
      "additionalProperties": false
    },
    "nemesis": {
      "type": "object",
      "required": ["trigger", "trigger_source", "duties", "ai_note"],
      "properties": {
        "trigger": {"type": "string", "minLength": 1},
        "trigger_source": {"$ref": "common.schema.json#/$defs/source"},
        "duties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["order", "duty", "source"],
            "properties": {
              "order": {"type": "integer", "minimum": 1},
              "duty": {"type": "string", "minLength": 1},
              "source": {"$ref": "common.schema.json#/$defs/source"}
            },
            "additionalProperties": false
          }
        },
        "ai_note": {
          "type": "object",
          "required": ["rule", "source"],
          "properties": {
            "rule": {"type": "string", "minLength": 1},
            "source": {"$ref": "common.schema.json#/$defs/source"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
