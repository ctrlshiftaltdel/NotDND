    "df_compare": [
      {"relation": "gt", "outcome": "达成", "source": "docs/system/02a-tactics-engine.md:40"},
      {"relation": "eq", "outcome": "达成（平手归属于行动方）", "source": "docs/system/02a-tactics-engine.md:41"},
      {"relation": "lt", "outcome": "未达成", "source": "docs/system/02a-tactics-engine.md:42"}
    ],
    "play_principle": "掷骰只用于：结果不确定、两边都有趣、此刻有压力。",
    "play_principle_source": "docs/system/02a-tactics-engine.md:55"
  },
  "skip_roll": [
    {"order": 1, "situation": "没有有意义的失败方式", "source": "docs/system/02a-tactics-engine.md:50"},
