  "acts": [
    {
      "id": "act-1",
      "name": "第一幕 · 口上与瓦脊",
      "level_range": "1",
      "summary": "目标：让玩家算清「下去容易上来贵」这笔账，并在第 1 层尝到「这里的东西会咬人」。幕末应当发生：玩家带着第一件出土物回到口上，发现它值钱、也有人抢，并第一次听说「有个匿名买家在追第九层的东西」。",
      "scenes": [
        "1.1 口上·集市：找董大娘置办绳索灯具／去缒行向甘不移问绳价／到灰秤行问出货行情（商谈或洞察 DF 12；失败＝买贵，背工价 +2）",
        "1.2 口上·行会（虞三娘）：申请下潜许可／从黑井偷渡／拿方梯的图换通行（说服或欺骗 DF 13；失败＝只能走绉褶口 C，更险更贵）",
        "1.3 第 1 层·瓦脊：顺绳下／走旧楼梯／摸去汪家大院（攀爬或察觉 DF 12；失败＝失足受轻伤，暴露在瓦鼠群前）",
        "1.4 第 1 层·瓦脊拾荒区：与拾荒队谈判分账／抢先下手／跟随捡漏（洞察或战斗 DF 13；冲突＝瓦脊拾荒队介入，可谈）",
        "1.5 口上·交割：把第一件出土物交灰秤行定级（无判定，郗允川估价；拍卖人薛弼年会挑明匿名买家这条线）"
      ],
      "tasks": [
        "Q-00"
      ],
      "source": "docs/scenario/S8-起步战役集.md:741"
    },
    {
      "id": "act-2",
      "name": "第二幕 · 铁骨渠与灰巷",
      "level_range": "1",
      "summary": "目标：让玩家第一次真正面对「负重是枷锁」，并认识「往下是自由的、往上要付钱」这条结构性权力。幕末应当发生：玩家取得核心目标物的第一半（或它的位置记录），并结下一笔需要选择立场的债。",
      "scenes": [
        "2.1 第 2 层·苔市：向蒲茂买菌粮／修输水管换补给／直接绕行（耐受或交涉 DF 12；失败＝配给只够走一半，或误入病田被孢子雾覆盖）",
        "2.2 第 3 层·铁骨渠：趁低水位过闸／拆闸／走沉箱绕行（运动或技艺 DF 14；拆闸＝引动水位守卫役形）",
        "2.3 第 3 层·渠心：取核心目标物的一处保管点（技艺或历史 DF 15；失败＝目标物损坏一半，但得到完整位置记录）",
        "2.4 第 4 层·灰巷（霍臻辖区）：交份子买通行／去窦阿兰的锅场当中立地／硬闯（交涉或潜行 DF 13；硬闯＝灰巷巡街队介入）",
        "2.5 第 4 层·黑井（捷径）：走黑井直上第 1 层／老实付背工价（攀爬 DF 15／谈判 DF 13；黑井失败＝井底的东西出现；付价＝花光本幕利润）"
      ],
      "tasks": [
        "Q-00"
      ],
      "source": "docs/scenario/S8-起步战役集.md:784"
    },
    {
      "id": "act-3",
      "name": "第三幕 · 盐廷与声窟",
      "level_range": "1",
      "summary": "目标：让玩家在「带得走」与「值得带」之间做一次不可逆的取舍，并面对「这东西也许不该被拿走」。幕末应当发生：玩家带着一个版本的结果回到口上，并永久改变某条供应链（缒价、层货定价，或匿名买家的身份）。",
      "scenes": [
        "3.1 第 5 层·盐廷（施舟亭）：谈判放行／出示对秩序的尊重／潜入禁窟碑（气场或历史 DF 14；失败＝持烛者守夜队拦路）",
        "3.2 第 5 层·中枢厅：取回权限令牌，读值契第九条（技艺或分析 DF 15；失败＝中枢厅门发动，封厅并召两具仪卫役形）",
        "3.3 第 6 层·声窟（下探）：保持静默前进／用声音引开响齿群／找沉语者听旧话（潜行或洞察 DF 15；出声＝音痂行者与响齿群齐至）",
        "3.4 第 7 层·脂海之堤（墨鸢）：听坼民的警告／强行取配重／留下东西换情报（共感或论战 DF 14；取配重＝坼民长者不可逆敌对）",
        "3.5 收束：带回／留下——玩家决定这一趟的最终结果（无判定；这是本册「活着回来的人才算赢」的落地）"
      ],
      "source": "docs/scenario/S8-起步战役集.md:823"
    }
  ],
