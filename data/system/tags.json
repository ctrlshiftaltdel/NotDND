  "interaction_principles": [
    {"order": 1, "name": "虚构优先",
     "rule": "如果两个标签的组合在叙事上明显说得通（汽油 × 火焰），按常识处理，通常给出 1 层额外增益（如 +1 助势骰或伤害 +2）",
     "source": "docs/system/01-core.md:236"},
    {"order": 2, "name": "宁可对玩家有利",
     "rule": "在不破坏场景的前提下，标签创意用法应当被奖励而非刁难。玩家动脑去观察环境是应当被鼓励的行为",
     "source": "docs/system/01-core.md:237"},
    {"order": 3, "name": "不得重复获利",
     "rule": "同一场合同一个创意不得重复获取同额收益，避免“我每次都用汽油”变成固定套路",
     "source": "docs/system/01-core.md:238"}
