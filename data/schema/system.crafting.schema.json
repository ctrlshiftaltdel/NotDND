{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "system 族（system.crafting）",
  "description": "互动层第四节：制作三要素、物品等级 4、品质五档、改造 5、三世界风味 3。源自 docs/system/03-互动层.md。只使用 data/FORMAT.md 第 7 节的关键字子集。",
  "type": "object",
  "required": ["schema_version", "kind", "source", "note", "declared", "components", "tiers", "quality_grades", "modifications", "mod_limit", "world_flavors"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "system.crafting"},
    "source": {"$ref": "common.schema.json#/$defs/source"},
    "note": {"type": "string", "minLength": 1},
    "declared": {
      "type": "object",
      "required": ["components", "item_tiers", "quality_grades", "modifications", "world_flavors", "max_mods_per_item"],
      "properties": {
        "components": {"const": 3},
        "item_tiers": {"const": 4},
        "quality_grades": {"const": 5},
        "modifications": {"const": 5},
        "world_flavors": {"const": 3},
        "max_mods_per_item": {"const": 3}
      },
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "required": ["source", "items", "blueprint_rarities", "blueprint_rarity_source", "material_qualities", "material_quality_source"],
      "properties": {
        "source": {"$ref": "common.schema.json#/$defs/source"},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "detail", "source"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "detail": {"type": "string", "minLength": 1},
              "source": {"$ref": "common.schema.json#/$defs/source"}
            },
            "additionalProperties": false
          }
        },
        "blueprint_rarities": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "blueprint_rarity_source": {"$ref": "common.schema.json#/$defs/source"},
        "material_qualities": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "material_quality_source": {"$ref": "common.schema.json#/$defs/source"}
      },
      "additionalProperties": false
    },
    "tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "examples", "worktime", "craft_df", "requirement", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "examples": {"type": "string", "minLength": 1},
          "worktime": {"type": "string", "minLength": 1},
          "craft_df": {"type": "integer", "minimum": 1},
          "requirement": {"type": "string", "minLength": 1},
          "source": {"$ref": "common.schema.json#/$defs/source"}
        },
        "additionalProperties": false
      }
    },
    "quality_grades": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "outcome", "name", "effect", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "effect": {"type": "string", "minLength": 1},
          "source": {"$ref": "common.schema.json#/$defs/source"}
        },
        "additionalProperties": false
      }
    },
    "modifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "df", "effect", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "df": {"type": "integer", "minimum": 1},
          "effect": {"type": "string", "minLength": 1},
          "source": {"$ref": "common.schema.json#/$defs/source"}
        },
        "additionalProperties": false
      }
    },
    "mod_limit": {
      "type": "object",
      "required": ["max", "rule", "source"],
      "properties": {
        "max": {"const": 3},
        "rule": {"type": "string", "minLength": 1},
        "source": {"$ref": "common.schema.json#/$defs/source"}
      },
      "additionalProperties": false
    },
    "world_flavors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["world", "craft_name", "trait", "source"],
        "properties": {
          "world": {"type": "string", "minLength": 1},
          "craft_name": {"type": "string", "minLength": 1},
          "trait": {"type": "string", "minLength": 1},
          "source": {"$ref": "common.schema.json#/$defs/source"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
