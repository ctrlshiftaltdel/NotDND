      {"name": "属性修正", "detail": "见 CORE 第 1 节量表，−2 至 +3", "source": "docs/system/02a-tactics-engine.md:31"},
      {"name": "熟练加值", "detail": "若该技能熟练：+2／+3／+4", "source": "docs/system/02a-tactics-engine.md:32"},
      {"name": "专精加值", "detail": "若该技能专精：额外 +1", "source": "docs/system/02a-tactics-engine.md:33"},
