  "acts": [
    {
      "id": "act-1",
      "name": "第一幕 · 雾中归路",
      "level_range": "1",
      "summary": "目标：让玩家在活雾里走完第一段路，理解「路会被弯回原处」，并第一次接触伊蕾芙（她主动接触玩家）。幕末应当发生：玩家确认「谷地在循环，而领主知道这件事，并且她想找人帮她结束它」。",
      "scenes": [
        "1.1 雾中的返途驿：跟车轮印走／跟小女孩走／上高地测路（雾行或洞察 DF 13；失败＝走回原地一轮，但线索反而更多）",
        "1.2 驿站遗址：进驿站找活人／先翻账本／屋外埋绳做路标（辨忆或分析 DF 12；失败＝登记簿损毁，伊诺·空铃补一句关键信息）",
        "1.3 雾中第二次相遇：与小女孩交谈／无视她／试着抓住她（共感或心智 DF 14；失败＝她一路跟随，终局会用到她）",
        "1.4 烬冠堡门前：递请柬进堡／绕侧门／护城河对岸观察（说服或欺骗 DF 13；失败＝塞芙兰·铜誓提出交换）",
        "1.5 宴会厅（第一次接触）：玩家自由回应对白（论战，立场 12；谈崩不是死路，伊蕾芙记下名字，终局论战 +2）"
      ],
      "tasks": [
        "Q-00"
      ],
      "source": "docs/scenario/S8-起步战役集.md:188"
    },
    {
      "id": "act-2",
      "name": "第二幕 · 五项冠证",
      "level_range": "1",
      "summary": "目标：玩家用「物证／人证／亡者回声」三条路径中的任意两条，拼出「循环是人造的」。幕末应当发生：玩家手里至少握有 2 件冠证，并知道摘冠会迁冠（杀死领主不是答案）。",
      "scenes": [
        "2.1 哀市（忆晶黑市）：买一枚净忆／找缪岑·空袋问路／查一枚剪忆的来源（辨忆 DF 13；失败＝假忆晶口音指向钟烬庭）",
        "2.2 钟骨修院：找玛铎恩长老／偷钟序记录／参与一次守夜（隐秘学或历史 DF 14；失败＝年轻抄士斐罗·碎钟私下塞残页）",
        "2.3 留名院：听妲芮·百名主持留名礼／查未入册的亡者名／与阿弥莎·无姓对话（悼仪 DF 14；失败＝获得「被抹去的名字」碎片）",
        "2.4 白穗乡：读农户的旧约／帮蒂宛·七户修渠／被素莱·轻灰跟踪（察觉 DF 13；失败＝密探脚印通向钟烬庭私兵名单）",
        "2.5 冠证汇合点：玩家把线索摆上桌做一次推理（无判定，纯推理；不完整也推进，终局论战立场 +4）"
      ],
      "tasks": [
        "Q-00"
      ],
      "source": "docs/scenario/S8-起步战役集.md:223"
    },
    {
      "id": "act-3",
      "name": "第三幕 · 第十三响",
      "level_range": "1",
      "summary": "目标：让玩家在杀死／取代／解放／交易四条路线里选一条，并承担代价。幕末应当发生：循环被改变（不必被终结），谷地的下一个「黎明」由玩家的选择定义。",
      "scenes": [
        "3.1 宴会厅（谈判）：完成一次完整论战／提出修复守冠誓／直接动手（论战立场 16，说服点 3；谈崩进入混战但伊蕾芙保留犹豫）",
        "3.2 王座厅（若开战）：对战伊蕾芙·冠下暴相／破坏冠炉／保护平民撤离（战斗＋一次气场 DF 18；杀死者失败则成为临时冠主）",
        "3.3 冠炉／钟塔：停钟／改钟序／用冠证撬动守冠誓（技术或历史 DF 16；失败＝钟仍响，但获得提前准备下一次循环的机会）",
        "3.4 雾岬界墙（收束）：玩家选择离开、留下、或取代（无判定；无论选哪条，雾都会给出一个信号）"
      ],
      "source": "docs/scenario/S8-起步战役集.md:265"
    }
  ],
