{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "system 族（system.attributes）",
  "description": "六维属性 + 等级表 + 属性修正表；只使用 data/FORMAT.md 第 7 节的关键字子集。",
  "type": "object",
  "required": ["schema_version", "kind", "source", "attributes", "levels", "modifiers"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "system.attributes"},
    "source": {"$ref": "common.schema.json#/$defs/source"},
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "en", "question", "source"],
        "properties": {
          "id": {"enum": ["MGT", "FIN", "VIG", "INS", "MND", "PRE"]},
          "name": {"type": "string", "minLength": 1},
          "en": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "source": {"$ref": "common.schema.json#/$defs/source"}
        },
        "additionalProperties": false
      }
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["value", "label", "source"],
        "properties": {
          "value": {"type": "integer", "minimum": 1, "maximum": 10},
          "label": {"type": "string", "minLength": 1},
          "example": {"type": "string"},
          "source": {"$ref": "common.schema.json#/$defs/source"}
        },
        "additionalProperties": false
      }
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["value", "modifier", "source"],
        "properties": {
          "value": {"type": "integer", "minimum": 1, "maximum": 10},
          "modifier": {"type": "integer", "minimum": -2, "maximum": 3},
          "source": {"$ref": "common.schema.json#/$defs/source"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
