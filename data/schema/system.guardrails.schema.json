{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "system 族（system.guardrails）",
  "description": "导引者操作系统第十四节：内容护栏（边界清单、三种终止机制）与一致性护栏（八项场景自检、数值 / 事实不变式、NPC 一致性）。源自 docs/system/04-conductor-os.md。只使用 data/FORMAT.md 第 7 节的关键字子集。",
  "type": "object",
  "required": ["schema_version", "kind", "source", "note", "declared", "boundary_checklist", "termination", "boundary_supplements", "scene_self_check", "numeric_invariants", "fact_invariant", "npc_consistency"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "system.guardrails"},
    "source": {"$ref": "common.schema.json#/$defs/source"},
    "note": {"type": "string", "minLength": 1},
    "declared": {
      "type": "object",
      "required": ["boundary_items", "termination_mechanisms", "boundary_supplements", "scene_self_checks", "numeric_invariants"],
      "properties": {
        "boundary_items": {"const": 5},
        "termination_mechanisms": {"const": 3},
        "boundary_supplements": {"const": 3},
        "scene_self_checks": {"const": 8},
        "numeric_invariants": {"const": 5}
      },
      "additionalProperties": false
    },
    "boundary_checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["order", "item", "source"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "item": {"type": "string", "minLength": 1},
          "source": {"$ref": "common.schema.json#/$defs/source"}
        },
        "additionalProperties": false
      }
    },
    "termination": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "usage", "response", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "usage": {"type": "string", "minLength": 1},
          "response": {"type": "string", "minLength": 1},
          "source": {"$ref": "common.schema.json#/$defs/source"}
        },
        "additionalProperties": false
      }
    },
    "boundary_supplements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["order", "rule", "source"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "rule": {"type": "string", "minLength": 1},
          "source": {"$ref": "common.schema.json#/$defs/source"}
        },
        "additionalProperties": false
      }
    },
    "scene_self_check": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["order", "check", "source"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "check": {"type": "string", "minLength": 1},
          "source": {"$ref": "common.schema.json#/$defs/source"}
        },
        "additionalProperties": false
      }
    },
    "numeric_invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["order", "invariant", "meaning", "source"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "invariant": {"type": "string", "minLength": 1},
          "meaning": {"type": "string", "minLength": 1},
          "source": {"$ref": "common.schema.json#/$defs/source"}
        },
        "additionalProperties": false
      }
    },
    "fact_invariant": {
      "type": "object",
      "required": ["rule", "example_bad", "example_good", "source"],
      "properties": {
        "rule": {"type": "string", "minLength": 1},
        "example_bad": {"type": "string", "minLength": 1},
        "example_good": {"type": "string", "minLength": 1},
        "source": {"$ref": "common.schema.json#/$defs/source"}
      },
      "additionalProperties": false
    },
    "npc_consistency": {
      "type": "object",
      "required": ["rule", "source"],
      "properties": {
        "rule": {"type": "string", "minLength": 1},
        "source": {"$ref": "common.schema.json#/$defs/source"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
