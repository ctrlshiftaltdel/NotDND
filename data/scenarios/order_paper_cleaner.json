  "acts": [
    {
      "id": "act-1",
      "name": "第一幕 · 晨",
      "level_range": "1",
      "summary": "目标：让玩家体验一次「命令基于旧地图」的经典落差，并学会用配给四轨思考问题。幕末应当发生：玩家守住或失去第七支撑点的一部分，并拿到第一份证实「命令过时」的证据。",
      "scenes": [
        "1.1 H-7 第七支撑点：修工事／挖一号机枪位下的 1192 年旧弹药箱／向班长要真图（技艺或洞察 DF 12；失败＝弹药轨 −1，但看懂墙上「别上 114」的炭字）",
        "1.2 碎镜滩（穿越）：夜间潜行／白天快速通过／走铁丝网缺口（潜行或生存 DF 14，夜间 −2 DF 但照明劣势 −1 骰；暴露＝渭军渗透兵前来接触，可以谈）",
        "1.3 磨石岗西坡：按令做「侦察性接触」，投入不少于八人（观察或射击 DF 13；发现阵地比图上多一个连——地图滞后 48 小时的第一课）",
        "1.4 遭遇：渭军巡逻——迎击／压制后撤／呼叫炮火（战斗 DF 12—14；呼叫失败＝发现哑塔无应答，牵出老卓与截获电文）",
        "1.5 回撤·清点：按配给四轨结算弹药/口粮/药品/燃料（无判定，乔万石核对；减员表要求给出一名有名字的补兵）"
      ],
      "tasks": [
        "Q-00"
      ],
      "source": "docs/scenario/S8-起步战役集.md:884"
    },
    {
      "id": "act-2",
      "name": "第二幕 · 雨",
      "level_range": "1",
      "summary": "目标：让玩家第一次面对「服从命令」与「做正确的事」的正面冲突，并接触命令链状态机。幕末应当发生：玩家要么完成一次注定要死人的任务，要么选择抗命并承担一条具体的代价。",
      "scenes": [
        "2.1 米线·第九公里：自己拉车／找司机郑四／向通达行殷其雷借车（技艺或说服 DF 13；失败＝补给晚到一场景）",
        "2.2 三营营部（温书迟）：请求修正任务／当面上报真图／沉默接下（论战或气场 DF 14；上报失败＝命令照发，参谋派与前线派矛盾暴露）",
        "2.3 磨石岗西坡（执行）：按令强攻／改为侦察后撤／只派八人做演示（战斗 DF 12—15；强攻＝掷弹兵与渭军班长加入；后撤＝郗鹤年记录一次抗命）",
        "2.4 白棚（蔺禾 / 傅明夷）：送伤员／交换俘虏祁五／查白旗会记录簿（交涉或洞察 DF 13；失败＝药品轨 −1，但记录簿有被涂掉的电文）",
        "2.5 抗命判定（可选）：走命令链状态机的「抗命」分支（气场或论战 DF 15；成功＝任务转向但纪律 −2；失败＝督战序列介入）"
      ],
      "tasks": [
        "Q-00"
      ],
      "source": "docs/scenario/S8-起步战役集.md:929"
    },
    {
      "id": "act-3",
      "name": "第三幕 · 夜",
      "level_range": "1",
      "summary": "目标：让玩家在炮火与通信中断中，为自己掌握的东西选一个归属，并接受「战争不以胜利收场」。幕末应当发生：玩家做出一个不可逆的选择，前线因此移动一次，世界账本记下他们是否抗命、以及谁活了下来。",
      "scenes": [
        "3.1 哑塔（老卓）：抢修通信／取他私藏的电池／用截获电文反向定位（技艺或通信 DF 15；失败＝命令链强制走「延迟」分支）",
        "3.2 磨石岗顶：按令夺取／炸断敌观察点后撤／把高地中立化（战斗或工兵 DF 15；失败＝渭军野炮组校射到位，全员负伤风险）",
        "3.3 抉择：把真相交给谁——交战区／交白旗会公开／交渭渡河民 / 通达行（论战或说服 DF 15；无论选谁，都有一个人为此承担代价）",
        "3.4 收束：谁活下来——结算减员与换防（无判定；这是本册「减员是常态」的落地，补兵永远是陌生人）"
      ],
      "source": "docs/scenario/S8-起步战役集.md:969"
    }
  ],
