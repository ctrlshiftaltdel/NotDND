{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "world 族（world.module）",
  "description": "世界模组（docs/scenario/05 阈界都市 / 06 余烬纪元 / 07 熵网）。三套模组共享同一机械语法、仅名称不同，故本 schema 覆盖其公共字段集；实体项已按 M1.2 实况收紧。只使用 data/FORMAT.md 第 7 节的关键字子集。",
  "type": "object",
  "required": ["schema_version", "kind", "source", "world", "factions",
               "tracks", "careers", "abilities", "equipment", "enemies", "random_tables"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "world.module"},
    "source": {"$ref": "common.schema.json#/$defs/source"},
    "world": {
      "type": "object",
      "required": ["key", "name", "engine"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "engine": {"enum": ["tactics", "build"]},
        "source": {"$ref": "common.schema.json#/$defs/source"}
      },
      "additionalProperties": false
    },
    "glossary": {"type": "array", "items": {"$ref": "#/$defs/glossary_entry"}},
    "factions": {"type": "array", "items": {"$ref": "#/$defs/faction"}},
    "regions": {"type": "array", "items": {"$ref": "#/$defs/region"}},
    "history": {"type": "array", "items": {"$ref": "#/$defs/history_entry"}},
    "tracks": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/track"}},
    "careers": {"type": "array", "items": {"$ref": "#/$defs/career"}},
    "abilities": {"type": "array", "items": {"$ref": "#/$defs/ability"}},
    "equipment": {"type": "array", "items": {"$ref": "#/$defs/equipment"}},
    "enemies": {"type": "array", "items": {"$ref": "#/$defs/enemy"}},
    "world_rules": {
      "type": "object",
      "description": "世界特则：各模组自有节（阈丝度 / 回声 / 薄处 / 抑噪器；烬值 / 燃痕 / 月相 / 根系 / 奉献；同步率 / 纯度 / 义体 / 网潜），故允许各世界自定义键。"
    },
    "random_tables": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/random_table"}}
  },
  "additionalProperties": false,
  "$defs": {
    "glossary_entry": {
      "title": "术语表条目",
      "type": "object",
      "required": ["term", "meaning", "source"],
      "properties": {
        "term": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1},
        "source": {"$ref": "common.schema.json#/$defs/source"}
      },
      "additionalProperties": false
    },
    "faction": {
      "title": "势力",
      "type": "object",
      "required": ["id", "name", "summary", "source"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/entity_id"},
        "name": {"type": "string", "minLength": 1},
        "alignment": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "source": {"$ref": "common.schema.json#/$defs/source"}
      },
      "additionalProperties": false
    },
    "region": {
      "title": "地理区域",
      "type": "object",
      "required": ["id", "name", "source"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/entity_id"},
        "name": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "atmosphere": {"type": "string"},
        "key_places": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "powers": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "events": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source": {"$ref": "common.schema.json#/$defs/source"}
      },
      "additionalProperties": false
    },
    "history_entry": {
      "title": "历史事件",
      "type": "object",
      "required": ["id", "name", "detail", "source"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/entity_id"},
        "year": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1},
        "source": {"$ref": "common.schema.json#/$defs/source"}
      },
      "additionalProperties": false
    },
    "career_ability": {
      "title": "职途起始能力",
      "type": "object",
      "required": ["name", "effect"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "cost": {"type": "string"},
        "effect": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "career": {
      "title": "职途",
      "type": "object",
      "required": ["id", "name", "role", "focus", "vitality_bonus", "skills",
                   "gear", "abilities", "specializations", "source"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/entity_id"},
        "name": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "focus": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "vitality_bonus": {"type": "integer", "minimum": 0},
        "skills": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "gear": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "abilities": {"type": "array", "items": {"$ref": "#/$defs/career_ability"}},
        "specializations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "note": {"type": "string"},
        "source": {"$ref": "common.schema.json#/$defs/source"}
      },
      "additionalProperties": false
    },
    "ability": {
      "title": "能力（共鸣式 / 秘仪 / 协议）",
      "type": "object",
      "required": ["id", "name", "category", "tier", "ap", "costs", "effect", "source"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/entity_id"},
        "name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "tier": {"enum": ["轻", "中", "重"]},
        "ap": {"type": "integer", "minimum": 0},
        "costs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/cost"}},
        "effect": {"type": "string", "minLength": 1},
        "source": {"$ref": "common.schema.json#/$defs/source"}
      },
      "additionalProperties": false
    },
    "equipment": {
      "title": "装备",
      "type": "object",
      "required": ["id", "name", "kind", "price_tier", "source"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/entity_id"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["weapon", "armor", "gear"]},
        "damage": {"type": "string", "minLength": 1},
        "ap": {"type": "integer", "minimum": 0},
        "range": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "guard": {"type": "string", "minLength": 1},
        "load": {"type": "string", "minLength": 1},
        "restriction": {"type": "string", "minLength": 1},
        "effect": {"type": "string", "minLength": 1},
        "price_tier": {"type": "string", "minLength": 1},
        "source": {"$ref": "common.schema.json#/$defs/source"}
      },
      "additionalProperties": false
    },
    "enemy": {
      "title": "敌体",
      "type": "object",
      "required": ["id", "name", "tier", "vitality", "guard", "poise",
                   "attack_bonus", "damage", "persona", "trait", "source"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/entity_id"},
        "name": {"type": "string", "minLength": 1},
        "tier": {"enum": ["杂兵", "杂兵（群）", "标准", "精锐", "首领"]},
        "vitality": {"type": "integer", "minimum": 1},
        "guard": {"type": "integer", "minimum": 0},
        "poise": {"type": "integer", "minimum": 0},
        "attack_bonus": {"type": "string", "minLength": 1},
        "damage": {"type": "string", "minLength": 1},
        "persona": {"enum": ["狡诈", "猛攻", "召唤", "守护", "控场", "领袖"]},
        "trait": {"type": "string", "minLength": 1},
        "source": {"$ref": "common.schema.json#/$defs/source"}
      },
      "additionalProperties": false
    }
  }
}
