  "acts": [
    {
      "id": "act-1",
      "name": "第一幕：钩住",
      "level_range": "1–3",
      "summary": "目标：弄清楚为什么「第 41 次备份」会在网里自己动。收束条件：玩家确认「第 41 次备份里有两个意识，而且其中一个不属于这个世界」。",
      "scenes": [
        "场景 1（张力 3）：一次普通的例行备份。玩家在档案层的一个隔间里，看见一台老式备份舱里躺着叶槐——他只说了一句话：「你们终于来了。」",
        "场景 2（张力 5）：备份数据里出现了一段不该存在的日志——它记录的是一段三十一年前的、网潜退出的失败尝试。时间戳早于叶槐出生",
        "场景 3（张力 6）：裴晚失踪了。她的工位被清空，只剩一张纸条和一个坐标——指向无名区的一处旧中继"
      ],
      "tasks": [
        "Q-00"
      ],
      "source": "docs/scenario/09-起步战役.md:325"
    },
    {
      "id": "act-2",
      "name": "第二幕：恶化",
      "level_range": "1–3",
      "summary": "目标：决定要不要把第 41 次备份带出熵网。收束条件：玩家选定一种做法，并为此付出第一个真实代价——删掉自己的一段记忆，或失去一个身份。",
      "scenes": [
        "场景 1（张力 5）：玩家第一次真正下网。第四十一次备份在网里有一个「影子」——它会在玩家靠近时用叶槐无法知道的细节描述玩家",
        "场景 2（张力 7）：裴晚的清洗次数被揭示：她已经删掉了自己近二十年的记忆。她记不清母亲的脸了。而她不记得自己记不清",
        "场景 3（张力 8）：邵诤不再等交易了。云枢启动「回收程序」，加密整个隔间，开始把备份上传到云端——一旦上传完成，裴芜会被拆成训练数据"
      ],
      "tasks": [
        "Q-00"
      ],
      "source": "docs/scenario/09-起步战役.md:341"
    },
    {
      "id": "act-3",
      "name": "第三幕：摊牌",
      "level_range": "1–3",
      "summary": "目标：在上传完成前，对容器做最后一个决定。高潮三要素：无论选什么，都会有人失去一段自己；知情的选择；第 41 次备份一旦被写入或清除，这个「她」就再也不会以同样的方式存在第二次。",
      "source": "docs/scenario/09-起步战役.md:362"
    }
  ],
