  "declared": {"pool_parts": 4, "die_rates": 4, "required_successes": 8},
  "pool": {
    "formula": "骰池 = 主属性枚数 + 技能熟练枚数 + 临时加成枚数",
    "parts": [
      {"name": "主属性枚数", "detail": "= 该属性的值本身（属性 5 → 5 枚骰）", "source": "docs/system/02B-构建引擎.md:37"},
      {"name": "技能熟练枚数", "detail": "= 熟练加值的一半（向上取整）：+2 → +1 枚；+3 → +2 枚；+4 → +2 枚", "source": "docs/system/02B-构建引擎.md:38"},
      {"name": "技能专精", "detail": "额外 +1 枚", "source": "docs/system/02B-构建引擎.md:39"},
      {"name": "临时加成", "detail": "协助、态势、场地要素等提供的额外骰子，通常 1–3 枚", "source": "docs/system/02B-构建引擎.md:40"}
    ],
    "note": "构建引擎里的「加值」几乎都转换为骰子枚数，而不是固定数字；这让每一次加成都看得见、数得着。"
  },
  "success_threshold": {
    "rule": "骰池里的每一枚骰，点数 ≥ 5 记作 1 次成功。",
    "threshold": 5,
    "default_die": "d10",
    "die_rates": [
      {"die": "d6", "rate": "33%", "source": "docs/system/02B-构建引擎.md:50"},
