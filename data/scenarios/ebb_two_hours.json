  "acts": [
    {
      "id": "act-1",
      "name": "第一幕 · 赊来的铲子",
      "level_range": "1",
      "summary": "目标：让玩家亲身体验「退潮窗口只有一个」，并在第一幕末尾第一次公开看到八家字号的轨格。幕末应当发生：玩家带回一件真实的落滩收获（一处刻名、一枚汐金样本、或一具旧靴），并意识到「城里有人在跟他们抢同一片滩」。",
      "scenes": [
        "1.1 三号码头（出发）：向老蚬婆问退潮时辰／直接下滩／先去鱼栏巷找陈三娘打听（人脉或说服 DF 12）",
        "1.2 蚝壳滩·碎壳带：按路引走／跟拾滩人下铲／找会改道的潮沟迷宫（水情·读泥 DF 13；失败＝掉进深沟，但沟底露出线索）",
        "1.3 老蚝架（O1 年木桩）：拓印刻名／数桩基走向／与拾滩人蚬仔搭话（历史或共感 DF 13；失败＝蚬仔说「那上面有个『晚』字」）",
        "1.4 城门口（第一次公开轨格）：玩家听导引者宣布八家字号轨格（无判定；无论玩家做什么，轨格照推）",
        "1.5 交割（与卢铁牛）：老实分三成／藏起一部分／问他船板的来历（欺骗 DF 13；失败＝修船/借船路线涨价或关闭）"
      ],
      "tasks": [
        "Q-00"
      ],
      "source": "docs/scenario/s8-starter-campaigns.md:463"
    },
    {
      "id": "act-2",
      "name": "第二幕 · 公开的竞速",
      "level_range": "1",
      "summary": "目标：让玩家见识八家字号如何推进，并第一次面对「换边」的诱惑与代价。幕末应当发生：玩家要么挂靠了某一家（共享其轨），要么开了自己的散客轨；并且至少让一家字号减了一格。",
      "scenes": [
        "2.1 落市负二层（秤仙）：称自己的水钱／买一条线索／请他转让一份债权（称量或人脉 DF 13）",
        "2.2 盐仓区：查账本／找账房温秉文／伪造查验文书（欺骗 DF 14／分析 DF 13）",
        "2.3 船坞／蚝壳帮：找柯九斤谈／揭发阮阿蟹／直接站队（论战立场 13；谈崩＝阿箩私下给一条巷子路线）",
        "2.4 桩林区（浅区）：退潮进入／遭遇夜汐会暗桩岑晚／目击浮台（水情 DF 14／潜行 DF 13）",
        "2.5 势力对账（幕末）：导引者公开全部轨格，玩家选择挂靠或散客（无判定；换边代价见 S3 第 5.1 节）"
      ],
      "tasks": [
        "Q-00"
      ],
      "source": "docs/scenario/s8-starter-campaigns.md:506"
    },
    {
      "id": "act-3",
      "name": "第三幕 · 满汐日",
      "level_range": "1",
      "summary": "目标：让玩家在「抢一笔钱」与「不让城被淹」之间做选择，并第一次下到沉闸外围。幕末应当发生：玩家做出一个方向性的选择（独吞／交给某势力／谁都没拿到／不挖），并留下下一季的钩子。",
      "scenes": [
        "3.1 满汐日前的落市：买齐装备／买单条情报／掺和一次拍卖（谈判 DF 13；失败＝满汐日溢价 ×1.5）",
        "3.2 深退·桩林区深处：走桩顶／涉水／绕对手的路线（杂技 DF 14／水情 DF 15；失败＝陷入淤泥，救援过程给一条新路）",
        "3.3 沉闸外围：用闸钥开门／强行开启（技术 DF 20，3 时段）／撤退（技术 DF 18-20；门开不了也推进——带走闸室内部结构图）",
        "3.4 回涨（场地级计时器）：每回合水位 +1 米，必须在时限内撤离（运动 DF 16；失败＝失去一半携带物，但人活着）",
        "3.5 收束：玩家在「独吞／交付／不挖」之间选择（无判定；三种收束各自接 S3 正式战役的不同终局）"
      ],
      "source": "docs/scenario/s8-starter-campaigns.md:545"
    }
  ],
